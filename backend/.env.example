# Copy to backend/.env and fill in. Never commit .env.

# --- Required for the AI agent -------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any current Gemini model that supports JSON structured output.
GEMINI_MODEL=gemini-3.8-flash

# --- Agent / limits -----------------------------------------------------------------------
AGENT_MAX_ITERATIONS=5
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=50000
MAX_MODIFIED_ROWS=5000
MAX_UPLOAD_MB=100
# Data sent to Gemini besides the schema: sample rows per table and first result rows.
# Set both to 0 if your data must not leave this machine.
SCHEMA_SAMPLE_ROWS=3
LLM_RESULT_PREVIEW_ROWS=10

# --- Deployment ---------------------------------------------------------------------------
# true  = local mode: users may open/edit files on THIS machine by path (default; bind to 127.0.0.1).
# false = hosted mode: only uploads (and browser write-back) are allowed.
ALLOW_LOCAL_FILE_PATHS=true
# Shared access key required by the API when set. Use a long random value for any public deployment.
APP_ACCESS_TOKEN=
# Where uploads, exports and backups are stored.
# DATA_DIR=./data
# CORS_ORIGINS=["http://localhost:5173"]
# Local mode only accepts these Host headers (DNS-rebinding protection).
# TRUSTED_HOSTS=["127.0.0.1","localhost"]
